<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Uygulama ag erisimi gerektirir (login/refresh, scan gonderimi). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- NFC etiket okuma (devriye noktalari). -->
    <uses-permission android:name="android.permission.NFC"/>
    <!-- Android 13+ bildirim gosterimi (FCM push). Calisma zamaninda
         FirebaseMessaging.requestPermission() ile istenir; reddedilirse
         push gosterilmez ama uygulama normal calisir. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Acil durum alarmina konum eklemek icin (best-effort; izin verilmezse
         alarm konumsuz gider, BEKLETILMEZ). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- NFC olmayan cihazlarda da kurulabilsin; donanim zorunlu degil. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false"/>
    <application
        android:label="Yönetiyor"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- (P155 §8) APP LINKS — davet bagi (https://<portal>/davet/…)
                 KULLANICI HICBIR SEY ARAMADAN uygulamayi acsin.
                 `autoVerify`: sistem alan adinin kokunde
                 `/.well-known/assetlinks.json`i dogrular (Caddy servis
                 ediyor). Parmak izi Play App Signing anahtarininki olmali
                 (KONSOL ISI — bkz. docs/derin-baglanti-kurulum.md).
                 IKI ALAN: prod(yeni yonetiyor.com) + prod(eski yonetio.site).
                 YOL ONEKI /davet: diger bag turleri (gizlilik/hesap-silme)
                 tarayicida kalir. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="yonetiyor.com" android:pathPrefix="/davet"/>
                <data android:scheme="https" android:host="yonetio.site" android:pathPrefix="/davet"/>
            </intent-filter>
        </activity>
        <!-- (P155 §8) Flutter'in YERLESIK derin baglanti yonlendirmesi:
             gelen App Link'in YOLU (/davet/<jeton>) go_router'a verilir. -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true" />
        <!-- (P154 / Asama 4) SOSYAL GIRIS GERI DONUSU.
             Saglayici arka ucun https callback'ine doner; arka uc da
             tarayiciyi bu ozel semaya yonlendirir ve guvenli tarayici
             oturumu (Custom Tabs) boylece KAPANIR. Bu filtre olmadan
             kullanici bos bir tarayici sekmesinde kalirdi.
             Sema, arka uctaki `oauth_mobil_donus` ile AYNI olmali. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.app.yonetiyor"/>
            </intent-filter>
        </activity>
        <!-- Bildirim kucuk ikonu: Android bunu ALFA MASKESI olarak cizer —
             renk atilir, yalniz saydamlik kalir. Bu yuzden tam (gradyanli)
             logo DEGIL, basitlestirilmis monokrom isaret kullanilir; aksi
             halde beyaz bir leke gorunurdu. Ayarlanmazsa sistem uygulama
             ikonunu kullanir ve ayni sekilde lekelenirdi. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_yonetio" />
        <!-- Sistemin kucuk ikonu/basligi boyadigi vurgu rengi. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/yonetio_teal" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- image_picker: Android 11+ paket gorunurlugu — foto cekimi sistem
             kamera uygulamasina devredilir (bu yuzden ayrica CAMERA izni
             GEREKMEZ; galeri secimi sistem picker'i kullanir). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <!-- url_launcher: tel: linki icin arama uygulamasi gorunurlugu
             (acil durumda "Yonetimi ara"). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
