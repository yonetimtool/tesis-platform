<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- ISO7816 UYGULAMA KIMLIKLERI (AID) — CIHAZDA BULUNAN EKSIK.
	     BELIRTI: "Missing required entitlement", oturum BASLADIKTAN
	     sonra, etikete BAGLANIRKEN. codesign yetkilendirmeyi gosteriyor,
	     profil NDEF/TAG/PACE tasiyor, portalda yetenek acik — ama
	     `nfcd` gunlugunde oturum/yetki satiri YOK. Cunku ret `nfcd`ye
	     hic ULASMIYOR: CoreNFC uygulama icinde reddediyor.

	     MEKANIZMA: bizim etiketimiz NTAG424 DNA'dir ve iOS onu MIFARE
	     **DESFire** ailesi olarak gorur (bkz. nfc_service.dart:
	     `MiFareFamilyIos.desfire => NfcTagType.ntag424`). DESFire bir
	     ISO7816 uygulamasidir; CoreNFC bir ISO7816 etiketine
	     `NFCTagReaderSession.connect(to:)` yaparken uygulamanin
	     SECEBILECEGI uygulama kimliklerini burada BEYAN ETMIS olmasini
	     sart kosar. Liste yoksa baglanti "Missing required entitlement"
	     ile reddedilir — eklentideki cagri
	     `session.connect(to: tags.first!)` (NfcManagerPlugin.swift:647)
	     ve hatanin kaynagi da bu:
	     okadan/flutter-nfc-manager#74 (`_connectTag:error:670`).

	     NEDEN ANDROID'DE GORUNMEDI: Android'de boyle bir on-beyan
	     kurali yoktur; etikete dogrudan baglanilir.

	     LISTE: NTAG424 DNA bir NFC Forum Type 4 etiketidir; secilen
	     uygulama NDEF uygulamasidir. Type 4 v2 = D2760000850101,
	     v1 = D2760000850100. Baska AID EKLENMEDI: alakasiz kimlik
	     yazmak (bazi ornek yapilandirmalarda goruldugu gibi) beyani
	     gercege aykiri kilar ve denetimde aciklanamaz. -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>D2760000850101</string>
		<string>D2760000850100</string>
	</array>
	<!-- Core NFC: kullaniciya gosterilen NFC erisim aciklamasi. -->
	<key>NFCReaderUsageDescription</key>
	<string>Used to read the NFC tags at patrol checkpoints so a scan can be recorded as proof that the round was walked.</string>
	<!-- image_picker: gorev tamamlama foto kaniti (kamera + galeri). -->
	<key>NSCameraUsageDescription</key>
	<string>Used to take photos you attach to tasks, maintenance requests, events, parcels and site rules.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to pick existing photos to attach to tasks, maintenance requests, events and announcements.</string>
	<!-- geolocator: acil durum alarmina konum eklemek icin (best-effort). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used while you are scanning a patrol checkpoint or sending an emergency alert, to record where it happened. The app never tracks your location in the background.</string>
	<!-- url_launcher: tel: linkiyle yonetim numarasini arama. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
	</array>
	<!-- KAMERA YAYINLARI ICIN ATS ISTISNASI (P25b).
	     iOS'ta App Transport Security duz http yuklemelerini engeller; saha
	     kameralarinin restream gecidi (Frigate/go2rtc) neredeyse her zaman duz
	     http'tir, dolayisiyla oynatici sessizce dusuyordu.
	     `NSAllowsArbitraryLoadsForMedia` KAPSAMI DAR bir istisnadir: yalnizca
	     AVFoundation medya yuklemelerini kapsar — URLSession trafigi (API
	     cagrilari) ATS korumasinda KALIR. Android'de medyaya ozel bir
	     karsiligi yoktur (bkz. res/xml/network_security_config.xml). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
		<string>ar</string>
		<string>ru</string>
		<string>de</string>
		<string>fr</string>
		<string>es</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Yönetio</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Yonetio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- (P155 §8) Flutter'in YERLESIK derin baglanti yonlendirmesi. Gelen
	     Universal Link'in YOLU (/davet/<jeton>) dogrudan go_router'a
	     verilir; ek paket (app_links/uni_links) GEREKMEZ. -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
</dict>
</plist>
