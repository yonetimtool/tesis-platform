<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- ISO7816 UYGULAMA KIMLIKLERI (AID) — CIHAZDA BULUNAN EKSIK.
	     BELIRTI: "Missing required entitlement", oturum BASLADIKTAN
	     sonra, etikete BAGLANIRKEN. codesign yetkilendirmeyi gosteriyor,
	     profil NDEF/TAG/PACE tasiyor, portalda yetenek acik — ama
	     `nfcd` gunlugunde oturum/yetki satiri YOK. Cunku ret `nfcd`ye
	     hic ULASMIYOR: CoreNFC uygulama icinde reddediyor.

	     MEKANIZMA: bizim etiketimiz NTAG424 DNA'dir ve iOS onu MIFARE
	     **DESFire** ailesi olarak gorur (bkz. nfc_service.dart:
	     `MiFareFamilyIos.desfire => NfcTagType.ntag424`). DESFire bir
	     ISO7816 uygulamasidir; CoreNFC bir ISO7816 etiketine
	     `NFCTagReaderSession.connect(to:)` yaparken uygulamanin
	     SECEBILECEGI uygulama kimliklerini burada BEYAN ETMIS olmasini
	     sart kosar. Liste yoksa baglanti "Missing required entitlement"
	     ile reddedilir — eklentideki cagri
	     `session.connect(to: tags.first!)` (NfcManagerPlugin.swift:647)
	     ve hatanin kaynagi da bu:
	     okadan/flutter-nfc-manager#74 (`_connectTag:error:670`).

	     NEDEN ANDROID'DE GORUNMEDI: Android'de boyle bir on-beyan
	     kurali yoktur; etikete dogrudan baglanilir.

	     LISTE: NTAG424 DNA bir NFC Forum Type 4 etiketidir; secilen
	     uygulama NDEF uygulamasidir. Type 4 v2 = D2760000850101,
	     v1 = D2760000850100. Baska AID EKLENMEDI: alakasiz kimlik
	     yazmak (bazi ornek yapilandirmalarda goruldugu gibi) beyani
	     gercege aykiri kilar ve denetimde aciklanamaz. -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>D2760000850101</string>
		<string>D2760000850100</string>
	</array>
	<!-- Core NFC: kullaniciya gosterilen NFC erisim aciklamasi. -->
	<key>NFCReaderUsageDescription</key>
	<string>Used to read the NFC tags at patrol checkpoints so a scan can be recorded as proof that the round was walked.</string>
	<!-- image_picker: gorev tamamlama foto kaniti (kamera + galeri). -->
	<key>NSCameraUsageDescription</key>
	<string>Used to take photos you attach to tasks, maintenance requests, events, parcels and site rules.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to pick existing photos to attach to tasks, maintenance requests, events and announcements.</string>
	<!-- KONUM — TEK KULLANIM YERI: devriye noktasi okutmasi.
	     `lib/src/features/scan/data/konum_servisi.dart` tek atis
	     `Geolocator.getCurrentPosition` cagirir; konum AKISI
	     (`getPositionStream`) ve `UIBackgroundModes` YOKTUR.
	     Tek cagiran `nfc_screen.dart` (okutma ekrani) — olculdu.

	     (P195) ESKI METIN "acil durum bildirimi"nden de soz ediyordu;
	     KOD BUNU YAPMIYOR (konum yalniz okutmada aliniyor). Apple
	     yaniltici amac metnini reddediyor ve bu metin yanilticiydi. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used while you are scanning a patrol checkpoint, to record where the scan happened as proof the round was walked. The app never tracks your location in the background.</string>
	<!-- (P195) APPLE 90683 ICIN GEREKLI — DAVRANIS DEGISMIYOR.
	     Yukleme "Missing purpose string ... NSLocationAlwaysAndWhenInUse
	     UsageDescription" ile reddedildi. Sebep bizim kodumuz DEGIL:
	     geolocator_apple ikilisi `requestAlwaysAuthorization` API'sine
	     referans veriyor ve App Store Connect'in STATIK taramasi anahtari
	     zorunlu kiliyor.

	     ANAHTARIN VARLIGI IZNI DEGISTIRMEZ — olculdu: eklentinin iOS
	     kodu (PermissionHandler.m) su sirayla bakiyor:
	         if  (NSLocationWhenInUseUsageDescription varsa)
	                 -> requestWhenInUseAuthorization
	         else if (Always aciklamasi varsa)
	                 -> requestAlwaysAuthorization
	     WhenInUse anahtarimiz VAR, yani `else if` dalina HIC girilmiyor:
	     uygulama her durumda YALNIZ "kullanirken" izni ister. Metin de
	     bunu soyler; arka plan takibi IMA ETMEZ. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>The app does not track your location in the background. Location is read only while you are actively scanning a patrol checkpoint, to record where the scan happened.</string>
	<!-- url_launcher: tel: linkiyle yonetim numarasini arama. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
	</array>
	<!-- KAMERA YAYINLARI ICIN ATS ISTISNASI (P25b).
	     iOS'ta App Transport Security duz http yuklemelerini engeller; saha
	     kameralarinin restream gecidi (Frigate/go2rtc) neredeyse her zaman duz
	     http'tir, dolayisiyla oynatici sessizce dusuyordu.
	     `NSAllowsArbitraryLoadsForMedia` KAPSAMI DAR bir istisnadir: yalnizca
	     AVFoundation medya yuklemelerini kapsar — URLSession trafigi (API
	     cagrilari) ATS korumasinda KALIR. Android'de medyaya ozel bir
	     karsiligi yoktur (bkz. res/xml/network_security_config.xml). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
		<string>ar</string>
		<string>ru</string>
		<string>de</string>
		<string>fr</string>
		<string>es</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Yönetiyor</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Yonetio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- (P194) IHRACAT UYUMLULUGU — her yuklemede sorulan "Missing
	     Compliance" sorusunun cevabi. Anahtar YOKSA App Store Connect
	     yuklemeyi bekletir ve soruyu ELLE cevaplatir; her yapimda
	     tekrarlanan bir adim olur.

	     `false` DOGRU CEVAP: uygulama KENDI sifrelemesini yapmiyor.
	       * Ag trafigi: yalniz HTTPS/TLS — isletim sisteminin sagladigi
	         standart sifreleme (muafiyet kapsaminda).
	       * Yerel depo: `flutter_secure_storage` -> iOS Keychain, yine
	         isletim sistemi sifrelemesi.
	       * NFC etiket dogrulamasi (NTAG424 SDM/CMAC) SUNUCUDA yapilir;
	         uygulama etiketin yukunu yalnizca ILETIR, cozmez.
	       * Bagimliliklarda kripto kitapligi YOK (pointycastle/encrypt vb.).

	     Bu yuzden ihracat kisitina tabi "non-exempt" sifreleme yoktur.
	     Uygulamaya bir gun kendi sifrelemesi eklenirse BU DEGER ve
	     App Store Connect cevabi birlikte gozden gecirilmelidir;
	     `ios_yapilandirma_test.dart` anahtarin sessizce kaybolmasini
	     yakalar ama YENI bir kripto kullanimini yakalayamaz. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- (P155 §8) Flutter'in YERLESIK derin baglanti yonlendirmesi. Gelen
	     Universal Link'in YOLU (/davet/<jeton>) dogrudan go_router'a
	     verilir; ek paket (app_links/uni_links) GEREKMEZ. -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<!-- (P181 Bölüm 10.4) OAuth ÖZEL ŞEMA — flutter_web_auth_2 tarayıcı
	     oturumunu kapatan geri-dönüş. Arka uçtaki `oauth_mobil_donus`
	     (com.app.yonetiyor://oauth) ile AYNI olmalı. Android tarafı
	     AndroidManifest.xml'de KAYITLIYDI, iOS'ta EKSİKTİ: bu olmadan
	     Google/Microsoft/Apple akışı tarayıcıdan uygulamaya DÖNEMİYORDU
	     (kullanıcı boş bir Safari sekmesinde kalırdı). Yalnız ŞEMA kaydı;
	     mevcut telefon/e-posta girişini ETKİLEMEZ. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.app.yonetiyor.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.app.yonetiyor</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
