<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- (P211 §6) PUSH BILDIRIM — IOS'TA BILDIRIM GELMEMESININ BIRINCI
	     SEBEBI BUYDU: `aps-environment` YOKTU.

	     Bu anahtar olmadan `registerForRemoteNotifications` APNs
	     jetonu ALMAZ; APNs jetonu olmayinca FCM `getToken()` ya null
	     doner ya `apns-token-not-set` atar — yani cihaz sunucuya HIC
	     kaydolmaz ve hicbir bildirim gelmez. Android tarafi calisirken
	     iOS'un sessiz kalmasinin dogal aciklamasi budur.

	     DEGER `development`: Xcode, App Store/TestFlight dagitiminda
	     imzalarken bunu `production` ile DEGISTIRIR. Elle `production`
	     yazmak, cihaza dogrudan kurulan (development imzali) yapida
	     jetonun alinmamasina yol acardi.

	     KONSOL ISI (yalniz bu dosya YETMEZ) — bkz. §6 listesi:
	       * Xcode > Signing & Capabilities > + Push Notifications,
	       * Apple Developer > App ID > Push Notifications yetenegi,
	       * APNs Auth Key (.p8) Firebase konsoluna yuklenmeli. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- (P114) CORE NFC. Bu yetkilendirme olmadan `nfc_manager` iOS'ta
	     SESSIZCE calismaz: okuma oturumu acilir gibi gorunur ama etiket
	     hic okunmaz. Yetkilendirme dosyasi TEK BASINA yetmez — Apple
	     Developer portalinda App ID'ye "NFC Tag Reading" yetenegi de
	     eklenmelidir (bkz. docs/app-store/ios-build-runbook.md).

	     NDEF: tur noktasi etiketlerinin ortak bicimi.
	     TAG: NTAG424 SDM dogrulamasi ISO7816 komutu ister; NDEF tek
	     basina o yolu KAPATIRDI. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- (P155 §8) UNIVERSAL LINKS — davet bagi
	     (https://<portal>/davet/<jeton>) uygulamayi dogrudan acsin.
	     Alan adlari SABIT (Team ID BURADA DEGIL, sunucudaki AASA'da):
	       yonetiyor.com      — prod (yeni birincil alan)
	       yonetio.site       — prod (eski alan, hâlâ calisir)
	     KONSOL ISI: Apple Developer'da App ID'ye "Associated Domains"
	     yetenegi eklenmeli (yalniz bu dosya yetmez) — bkz.
	     docs/derin-baglanti-kurulum.md. Prod build 3'te bu yok; derin
	     baglanti ancak YENI surumle calisir. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:yonetiyor.com</string>
		<string>applinks:yonetio.site</string>
	</array>
</dict>
</plist>
