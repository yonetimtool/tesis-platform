# /infra/.env.example — `cp .env.example .env` ile kopyalayin ve degerleri degistirin.
# docker compose bu dosyayi otomatik okur (ayni dizinde calistirildiginda).

# --- Postgres OWNER (superuser; migration'lar bununla calisir, RLS bypass) ---
POSTGRES_USER=tesis_owner
POSTGRES_PASSWORD=owner_secret_change_me
POSTGRES_DB=tesis

# --- Uygulama rolu (app_rw; RLS'e TABI; uygulama bununla baglanir) ---
APP_DB_USER=app_rw
APP_DB_PASSWORD=app_rw_secret_change_me

# --- JWT (token uretimi Prompt 2'de) ---
JWT_SECRET=change-me-please-use-a-long-random-32+char-secret

# --- NTAG424 SDM/SUN dogrulamasi ---
# Checkpoint etiket anahtarlarini sifreleyen KEK (32+ karakter, rastgele uret).
# Bos birakilirsa anahtar kaydi (PUT /checkpoints/{id}/sdm-key) 500 config_error.
SDM_KEK=change-me-random-32+chars-sdm-key-encryption-key

# --- MinIO (S3-uyumlu foto kanit deposu) ---
# Kok kimlik (minio container) — api/worker presign icin AYNI degerleri kullanir.
# Parola en az 8 karakter olmali (MinIO sarti).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin12345
MINIO_BUCKET=tesis-foto
# IC AG endpoint (api/worker -> minio); sunucu-tarafi cagri icin (su an kullanilmiyor).
MINIO_INTERNAL_ENDPOINT=http://minio:9000
# PUBLIC endpoint — presigned URL host'u; istemcinin (mobil/tarayici) erisebildigi adres.
# Yerel gelistirmede host'a maplenen port: http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# NOT: compose her MinIO degiskenine inline varsayilan (:-) verir; bu yuzden .env
# eksik olsa bile servisler bos deger ALMAZ ("not set" WARN olusmaz).

# --- Odeme saglayici (kart) — GERCEK ANAHTAR YOK (placeholder) ---
# manual | iyzico | paytr. Gercek tahsilat anahtarlar gelince (sandbox) denenecek.
PAYMENT_PROVIDER=manual
IYZICO_API_KEY=sandbox-iyzico-key
IYZICO_SECRET=sandbox-iyzico-secret
PAYTR_MERCHANT_ID=sandbox-mid
PAYTR_MERCHANT_KEY=sandbox-paytr-key
PAYTR_MERCHANT_SALT=sandbox-paytr-salt

# --- Push saglayici (FCM) ---
# Gercek FCM'i acmak icin (kimlik dosyasi infra/secrets/fcm-service-account.json,
# .gitignore'da — repoya girmez):
#   PUSH_PROVIDER=fcm
#   docker compose -f docker-compose.yml -f docker-compose.push.yml up -d
# Kimlik dosyasi container'a read-only mount edilir (FCM_SERVICE_ACCOUNT_PATH
# override'da set edilir); project_id dosyadan okunur (FCM_PROJECT_ID istege
# bagli override). Duman testi: exec api python -m scripts.push_smoke
# noop | fcm. Kimlik (project_id + service account json) bossa FcmProvider
# unconfigured -> no-op (sessiz cokme yok). Gercek Firebase kimligi gelince fcm'e alinir.
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_PATH: normalde docker-compose.push.yml verir; elle de verilebilir.
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=
FCM_BASE_URL=https://fcm.googleapis.com

# --- Icerik cevirisi (duyuru / site kurali / etkinlik — 7 dil) ---
# Ceviri motoru KENDI BARINDIRDIGIMIZ LibreTranslate'tir (compose'da
# `libretranslate` servisi; ic agda, port yayinlanmaz -> icerik disariya gitmez).
#
# api/worker DEV VARSAYILANI `echo`: deterministik sahte ceviri ("[ru] metin").
# Boylece test kosumu model indirmesine/CPU'ya bagli olmaz ve 600+ testin her
# icerik olusturmasi gercek ceviri kuyrugu tetiklemez.
# GERCEK ceviriyi acmak icin:
#   TRANSLATE_PROVIDER=libretranslate
#   docker compose up -d api worker
# libretranslate | echo | noop
TRANSLATE_PROVIDER=echo
TRANSLATE_URL=http://libretranslate:5000
# Yuklenecek modeller (mobil UI'nin 7 dili). Genisletmek migration ISTER
# (ceviri tablolarindaki ck_*_dil kisiti).
TRANSLATE_LANGS=tr,en,ar,ru,de,fr,es
# Seed ornek icerigi GERCEK hattan gecirir; istenirse burasi da echo yapilabilir.
SEED_TRANSLATE_PROVIDER=libretranslate

# NOT: DB/Redis URL'leri docker-compose.yml icinde yukaridaki degiskenlerden
# turetilir (servis hostname'leri: db, redis). Burada ayrica tanimlamaya gerek yok.

# --- (P154 / Asama 4) SOSYAL GIRIS — hepsi BOS: sosyal giris KAPALI ---
# Kapali saglayici ne mobilde ne web'de dugme olarak gorunur ve
# telefon/parola girisi hic etkilenmez. Konsol adimlari:
#   docs/oauth-kurulum.md
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=common
# OAUTH_APPLE_CLIENT_ID=com.app.yonetiyor.web
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY=
# `*_AUD`: `id_token.aud` icin KABUL EDILEN degerler (virgulle ayrilir).
# BOS BIRAKILIRSA ilgili CLIENT_ID kullanilir — yalniz web istemcisi
# varken yeterlidir. MOBIL EKLENINCE ZORUNLU: Google/Apple mobil icin
# AYRI istemci kimligi uretir ve jetonun `aud`u O kimligi tasir; liste
# guncellenmezse mobil giris sessizce reddedilir.
# OAUTH_GOOGLE_AUD=
# OAUTH_MICROSOFT_AUD=
# OAUTH_APPLE_AUD=
# Saglayiciya bildirilen redirect_uri'nin tabani. TERS VEKIL ARKASINDA
# ZORUNLU: istekten turetilen adres kayitli adresle tutmaz.
# OAUTH_CALLBACK_TABAN=https://api.ornek.com
# BOS = O YUZEY KAPALI (`baslat` 503 doner — hata kullanici siteden
# AYRILMADAN gorunur).
# OAUTH_WEB_DONUS=https://panel.ornek.com/giris/oauth
# OAUTH_MOBIL_DONUS=com.app.yonetiyor://oauth
