# ==========================================================================
# TEST SUNUCUSU (192.168.1.25) — ORTAM DEGISKENI OVERRIDE'LARI
# ==========================================================================
# Test sunucusu, prod compose'unu (docker-compose.prod.yml) calistirir ama
# birkac degiskeni kendi degeriyle EZER. `cp .env.test.example .env.test`
# yapip degerleri doldurun, sonra:
#   docker compose -f docker-compose.prod.yml --env-file .env.test up -d
#
# ONEMLI — ADRES POLITIKASI: `test.yonetio.site`, `app-test`, `panel-test`,
# `api-test` adresleri kodda/dokumanda/testte ARTIK GECMEZ. TEK MESRU YER
# BU DOSYADIR: burada yalniz ORTAM DEGISKENI DEGERI olarak dururlar.
# Kanonik adresler (prod): yonetiyor.com, app./panel./api.yonetiyor.com.
#
# Test sunucusu HENUZ KAPANMADI: prod dagitimi (192.168.1.105) dogrulanana
# kadar geri donus noktasi olarak duruyor. Buraya YENI dagitim yapilmaz.
# ==========================================================================

# --- Tanitim sitesi (apps/tanitim-web) — test konaklari --------------------
# Yayin konagi ve eski yollarin (/davet/*, /gizlilik, /kosullar, /hesap-silme)
# 301'lenecegi calisma alani. Bu yollar test.yonetio.site uzerinde CALISIYOR.
TANITIM_DOMAIN=test.yonetio.site
TANITIM_ESKI_HEDEF=https://app-test.yonetio.site

# NEXT_PUBLIC_* DERLEME ANINDA gomulur: degistirince tanitim-web'i `--build`
# ile yeniden kurun (yalniz `up -d` YETMEZ).
TANITIM_APP_ADRESI=https://app-test.yonetio.site
TANITIM_SITE_ADRESI=https://test.yonetio.site

# --- TLS: tunel arkasinda dahili sertifika (bkz. .env.prod.example P154) ----
# Cloudflare Tunnel arkasinda ACME origin'e ulasamaz; `tls internal` sart.
# TIRNAKSIZ yaz. Bu satir yoksa/bossa Caddy ACME'ye duser ve sertifika alamaz.
CADDY_TLS=tls internal

# --- Push: TEST'te KAPALI --------------------------------------------------
# noop ZORUNLU: test ve prod AYNI Firebase projesini kullanir; PUSH_PROVIDER=fcm
# olsaydi test sunucusu GERCEK/CANLI cihazlara push atardi. noop = hic gonderim.
PUSH_PROVIDER=noop
