# =========================================================================
# Yonetio — URETIM ortam degiskenleri
#   cp .env.prod.example .env.prod && $EDITOR .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# SIRLAR ASLA repoya girmez — bu dosya yalniz ORNEKTIR (.env.prod .gitignore'da).
# Guclu deger uretimi:  openssl rand -base64 36   (ya da -hex 24)
# =========================================================================

# --- Zaman dilimi --------------------------------------------------------- #
TZ=Europe/Istanbul

# --- Alan adlari (DNS A kaydi bu sunucunun genel IP'sine bakmali) --------- #
# pfSense YALNIZ 80/443'u bu sunucuya iletir; ucu de ayni IP'ye cozulmeli.
API_DOMAIN=api.yonetiyor.com
# YAYINDAKI mobil surumler api.yonetio.site'a derlenmis — o hostname YASIYOR;
# Caddy API'yi HER IKI hostname'den de servis eder (dual-serve, 301 YOK).
API_DOMAIN_ESKI=api.yonetio.site
PANEL_DOMAIN=panel.yonetiyor.com
STORAGE_DOMAIN=storage.yonetio.site
# (P149) BIRINCIL musteri alani: yonetiyor.com (ASCII, KANONIK). IDN bicimi
# (yönetiyor.com -> punycode) PORTAL_DOMAIN_IDN ile AYRICA servis edilir ve
# kanonige 301'lenir (compose varsayilani xn--ynetiyor-n4a.com). Punycode
# gerekirse: python3 -c "print('yönetiyor.com'.encode('idna').decode())"
PORTAL_DOMAIN=yonetiyor.com
PANEL_DOMAIN_YENI=panel.xn--ynetiyor-n4a.com
# ESKI kok alan — KAPATILMIYOR: incelemedeki mobil yapimin hukuki belge
# adresleri buraya bakiyor (bkz. docs/alan-adi-gecisi.md).
PORTAL_DOMAIN_ESKI=yonetio.site

# Let's Encrypt kayit/uyari e-postasi (sertifika suresi dolarken bildirim).
ACME_EMAIL=devops@yonetio.site

# --- Postgres OWNER (superuser; migration'lar bununla, RLS bypass) -------- #
POSTGRES_USER=tesis_owner
# openssl rand -base64 36
POSTGRES_PASSWORD=DEGISTIR_guclu_owner_parolasi
POSTGRES_DB=tesis

# --- Uygulama rolu (app_rw; RLS'e TABI; uygulama bununla baglanir) -------- #
APP_DB_USER=app_rw
# openssl rand -base64 36
APP_DB_PASSWORD=DEGISTIR_guclu_app_rw_parolasi

# --- JWT imzalama sirri (32+ karakter, rastgele) -------------------------- #
# openssl rand -base64 48
JWT_SECRET=DEGISTIR_uzun_rastgele_jwt_sirri_min_32_char

# --- NTAG424 SDM/SUN KEK (checkpoint etiket anahtar sifreleme; 32+ char) -- #
# openssl rand -base64 36
SDM_KEK=DEGISTIR_rastgele_32char_sdm_kek

# --- CORS ----------------------------------------------------------------- #
# Tarayicidan API'ye dogrudan cagri icin izinli origin(ler). Panel BFF sunucu
# tarafi cagirdigindan cogu akis buna ihtiyac duymaz; yine de panel origin'i
# verilir. Virgulle birden fazla eklenebilir.
# IDN NOTU: tarayici `Origin` basligini DAIMA punycode gonderir. Yine de
# her iki bicim de yazilabilir — arka uc yapilandirmayi punycode'a
# normallestirir (backend/app/config.py: cors_origin_list).
CORS_ORIGINS=https://panel.yonetiyor.com,https://app.yonetiyor.com

# --- Portal taban adresi -------------------------------------------------- #
# Sakine GIDEN mesajlardaki `{odeme_linki}` etiketi bundan uretilir.
# UNICODE yazilir: baglanti insanin okudugu mesaj metnine girer, `xn--...`
# bicimi SMS'te kimlik avi gibi gorunur.
PORTAL_BASE_URL=https://yönetiyor.com

# --- MinIO (S3-uyumlu foto deposu) ---------------------------------------- #
MINIO_ROOT_USER=yonetio_minio
# openssl rand -base64 36   (en az 8 karakter — MinIO sarti)
MINIO_ROOT_PASSWORD=DEGISTIR_guclu_minio_parolasi
MINIO_BUCKET=tesis-foto
# PUBLIC presigned URL host'u — istemci (mobil/tarayici) buraya PUT/GET yapar.
# Caddy bu alt-alani minio:9000'e (Host korunarak) proxy'ler. https OLMALI.
MINIO_PUBLIC_URL=https://storage.yonetio.site

# --- Push (FCM) ----------------------------------------------------------- #
# Varsayilan noop (push kapali; hicbir sey cokmez). GERCEK FCM icin:
#   1) Firebase service-account JSON'unu su yola koyun:
#        infra/secrets/fcm-service-account.json
#      (infra/secrets/ klasoru api & worker'a /secrets olarak read-only mount edilir)
#   2) PUSH_PROVIDER=fcm yapin.
# project_id JSON dosyasindan okunur; istege bagli override: FCM_PROJECT_ID.
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
# Genelde degistirmeyin (compose /secrets/fcm-service-account.json'a isaret eder).
FCM_SERVICE_ACCOUNT_PATH=/secrets/fcm-service-account.json

# --- Odeme saglayici (opsiyonel; gercek anahtar yoksa manual birakin) ----- #
PAYMENT_PROVIDER=manual
IYZICO_API_KEY=
IYZICO_SECRET=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# --- Yedekleme (infra/backup.sh) ------------------------------------------ #
# pg_dump ciktisini gpg simetrik sifreleyen parola. GUCLU olmali; bu parola
# KAYBOLURSA yedekler GERI YUKLENEMEZ. Ayri/guvenli yerde saklayin.
# openssl rand -base64 36
BACKUP_GPG_PASSPHRASE=DEGISTIR_yedek_sifreleme_parolasi
# Yedeklerin yazilacagi dizin (sunucuda kalici disk).
BACKUP_DIR=/opt/yonetio/backups

# --- Icerik cevirisi (yayin icerigi 7 dil) ---------------------------------- #
# Ceviri motoru KENDI SUNUCUNUZDA kosar (compose `libretranslate` servisi, ic
# ag; internete kapali) — icerik dis bir servise GITMEZ.
#
# OPERASYON: ilk kalkista argos modelleri indirilir (~1-2 GB, dakikalar surer)
# ve `ltmodels` volume'unde kalir. Modeller inene kadar ceviri isleri
# `durum='hata'` yazar; ORIJINAL metin servis edilmeye devam eder (icerik
# etkilenmez). Disk/bellek butcesini buna gore ayirin.
#
# libretranslate (varsayilan) | noop (ceviri kapali; icerik yine yazilir)
TRANSLATE_PROVIDER=libretranslate
TRANSLATE_URL=http://libretranslate:5000
# Yuklenecek diller. Kumeyi GENISLETMEK migration ister (ck_*_dil kisiti).
TRANSLATE_LANGS=tr,en,ar,ru,de,fr,es

# --- (P154 / Asama 4) SOSYAL GIRIS — hepsi BOS: sosyal giris KAPALI ---
# Kapali saglayici ne mobilde ne web'de dugme olarak gorunur ve
# telefon/parola girisi hic etkilenmez. Konsol adimlari:
#   docs/oauth-kurulum.md
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=common
# OAUTH_APPLE_CLIENT_ID=com.yonetiyor.web
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# .p8 ICERIGI tek satirda; satir sonlari \n olarak yazilir.
# OAUTH_APPLE_PRIVATE_KEY=
# `*_AUD`: `id_token.aud` icin KABUL EDILEN degerler (virgulle ayrilir).
# BOS BIRAKILABILIR: mobil giris de BACKEND-TARAYICI akisini (flutter_web_auth_2)
# kullanir, yani ayni WEB istemcisinden gecer ve `aud` = ilgili CLIENT_ID olur.
# (Yalniz ileride NATIVE bir mobil istemci eklenirse o kimlik buraya girer.)
# OAUTH_GOOGLE_AUD=
# OAUTH_MICROSOFT_AUD=
# OAUTH_APPLE_AUD=
# Saglayiciya bildirilen redirect_uri'nin TABANI (kanonik API host'u).
# Konsollara kaydedilen adres: <taban>/auth/oauth/callback/<saglayici>.
# iOS ve Android AYNIDIR (tarayici akisi). Ozel sema (OAUTH_MOBIL_DONUS)
# Google'a KAYDEDILMEZ — backend->uygulama devri uygulamada karsilanir.
# OAUTH_CALLBACK_TABAN=https://api.yonetiyor.com
# BOS = O YUZEY KAPALI (`baslat` 503 doner — hata kullanici siteden
# AYRILMADAN gorunur).
# OAUTH_WEB_DONUS=https://panel.yonetiyor.com/giris/oauth
# (P180) niyet=kayit donusu. BOS = SSO KAYIT KAPALI (basla'da 503).
# Giris akisi bundan etkilenmez.
#
# (P201) YOL `/giris/oauth` OLMALI — `/kayit` DEGIL.
# Callback `<adres>?oauth=<sonuc_id>` ile doner ve bu kimligi cozen TEK
# sayfa `/giris/oauth`tur (POST /auth/oauth/sonuc'u o cagirir); cozdukten
# sonra kullaniciyi zaten `/kayit`a birakir.
# BU ORNEK ONCEDEN `/kayit` DIYORDU ve prod'da olculen kayit dongusunun
# sebebi buydu: sonuc kimligi hicbir yerde tuketilmiyor, kullanici kayda
# BASTAN basliyordu. KONAK `app.*` DOGRUDUR (kayit yuzeyi orasi).
# Kod artik yanlis yola karsi da dayanikli (`/kayit` gelen `?oauth=`i
# `/giris/oauth`a devreder) ama DOGRU deger asagidakidir.
# OAUTH_KAYIT_DONUS=https://app.yonetiyor.com/giris/oauth
# OAUTH_MOBIL_DONUS=com.app.yonetiyor://oauth

# (P191 §1) admin-web konak-otesi yonlendirme hedefi (panel.* -> app.*).
# DERLEME ARGUMANIDIR: degistirince `docker compose build admin-web` gerekir.
# Bos birakilabilir — o zaman adres iletilmis basliklardan turetilir.
# ADMIN_WEB_APP_ADRESI=https://app.yonetiyor.com

# (P191 §1) OTURUM CEREZI ALAN ADI — panel.* ve app.* AYNI oturumu paylassin.
# BOS = konak-ozel cerez (eski davranis): panel.*'ta giris yapan bir yonetici
# app.*'a tasindiginda oturumunu KAYBEDER. Bastaki nokta ONEMLI.
# YALNIZ tum alt alanlari sizin barindirdiginiz alan adina ayarlayin.
COOKIE_DOMAIN=.yonetiyor.com

# --- E-POSTA (SMTP) — dogrulama kodu + bildirim e-postalari ----------------
# STARTTLS OTOMATIK (kod her zaman s.starttls() cagirir; standart port 587).
# SMTP_USER verilirse kimlik dogrulama yapilir. Kanonik: mail.yonetiyor.com.
# SMTP_HOST=mail.yonetiyor.com
# SMTP_PORT=587
# SMTP_USER=noreply@yonetiyor.com
# SMTP_PASSWORD=<posta-kutusu-parolasi>
# SMTP_FROM=noreply@yonetiyor.com

# ==========================================================================
# (P177) TANITIM SITESI — apps/tanitim-web
# ==========================================================================
# YALNIZ TEST SUNUCUSU ICIN. Prod (192.168.1.105) DONDURULMUS ve bu
# degiskenler orada TANIMSIZ birakilmalidir: tanimsizken Caddy blogu
# `tanitim.localhost` konagina baglanir, disariya acilmaz ve Let's
# Encrypt'e tek bir istek bile gitmez (bkz. Caddyfile tanitim blogu).
#
# UYARI — DOSYAYA EKLERKEN SATIR TEKRARI YAPMAYIN. Bir degisken iki kez
# yazildiginda SON deger gecerli olur; SMTP satirlari iki kez yazildigi
# icin ortam bir kez dustu. Eklemeden once mutlaka:
#     grep -n "^TANITIM_" .env.prod
# ==========================================================================

# Tanitim sitesinin yayin konagi + eski yollarin (/davet/*, /gizlilik,
# /kosullar, /hesap-silme) 301 ile gonderilecegi calisma alani.
#
# BU DEGISKENLER YALNIZ TEST SUNUCUSU ICINDIR; degerleri (test alan adlari
# dahil) infra/.env.test.example dosyasindadir. PROD'da TANIMSIZ birakilir
# (blok `tanitim.localhost`e baglanir, disariya acilmaz).
# TANITIM_DOMAIN=
# TANITIM_ESKI_HEDEF=

# --- TLS SAGLAYICISI (P154) — TUNEL ARKASINDA ZORUNLU ---------------------
# Cloudflare Tunnel (vb.) arkasindaki test sunucusunda TLS'i KENAR sonlandirir;
# ACME HTTP-01 dogrulamasi origin'e ULASAMAZ, Let's Encrypt sertifika ALAMAZ.
# `tls internal` verilince Caddy dahili CA ile imzalar (origin bacagi yine
# sifreli) ve ACME'ye HIC gitmez.
#
# BU SATIR YOKSA ya da BOS ise Caddy varsayilan OTOMATIK HTTPS'e duser ve
# ACME'ye gider — tunel arkasinda sertifika alinamaz, TLS el sikismasi duser.
# Yani DEGISKENIN YOKLUGU = ACME. `{$CADDY_TLS}` genislemesi bozuk degildir;
# bos degeri sadikca genisletir ve `tls` direktifi hic kurulmaz. Test
# sunucusunda MUTLAKA acik olmalidir (TIRNAKSIZ yaz):
# CADDY_TLS=tls internal
#
# PROD (192.168.1.105): TANIMSIZ birak — bos = otomatik HTTPS = gercek Let's
# Encrypt, prod davranisi aynen korunur.
#
# DIKKAT: .env.prod'u duzenledikten sonra caddy KONTEYNERI YENIDEN YARATILMALI
# (`up -d`, yalniz `restart` DEGIL) yoksa eski bos ortam konteynerde kalir.
# Dogrulama:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod exec caddy printenv CADDY_TLS

# --- DERLEME ANINDA GOMULEN DEGERLER (NEXT_PUBLIC_*) ----------------------
# Bunlar imaja DERLENIR: degistirdikten sonra `--build` ile yeniden
# kurulmalari gerekir, yalniz `up -d` YETMEZ.
# TANITIM_APP_ADRESI=   # test degerleri: infra/.env.test.example
# TANITIM_SITE_ADRESI=
# TANITIM_ILETISIM_EPOSTA=destek@yonetio.site
# "Tanıtım döneminde ücretsiz" rozeti (1 = gorunur). Varsayilan 1.
# TANITIM_UCRETSIZ=1
# Tekil oturum acma dugmeleri. Kapali olan dugme GORUNUR ama tiklanamaz,
# uzerinde "Yakında" rozeti olur. Saglayici hazir oldugunda YALNIZ bu
# deger 1 yapilir — kod degismez.
# TANITIM_SSO_GOOGLE=1
# TANITIM_SSO_MICROSOFT=0
# TANITIM_SSO_APPLE=0

# --- MAGAZA BAGLANTILARI (backend ile ORTAK) ------------------------------
# Bos birakilan magaza icin dugme CIZILMEZ — uydurma bir id ile kirik
# baglanti gostermek, hic gostermemekten kotudur. (P186) Ikisi de yayinda;
# config varsayilanlari dolu, asagidakiler yalniz OVERRIDE gerekirse.
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.app.yonetiyor
# APP_STORE_URL=https://apps.apple.com/tr/app/id6797316863

# ==========================================================================
# (P177) YENI KAYIT AKISI + GONDERIM KAPILARI — backend
# ==========================================================================
# YENI_KAYIT_AKISI=false iken yeni kayit uclari 503 doner ve MEVCUT KIMLIK
# SISTEMI BIREBIR bugunku gibi calisir.
# (P184) PROD'DA ACIK OLMALI: mobil kayit/tamamlama + SSO rol-tamamla bu bayrak
# olmadan calismaz (503). docker-compose.prod.yml varsayilani ARTIK `true`; bu
# satiri asagida ACIK BIRAKIYORUZ ki `.env.prod`de de net gorunsun. Kapatmak
# istersen `false` yaz.
YENI_KAYIT_AKISI=true

# SMS GONDERIMI — KAPALI. Verimor/Netgsm baslik onayi yok; telefon yalniz
# iletisim bilgisidir, dogrulama araci DEGILDIR. `false` iken saglayici
# ne olursa olsun SMS GONDERILMEZ.
# SMS_AKTIF=false

# TICARI ELEKTRONIK ILETI — KAPALI. Uculuk onayi SAKLANIR ama sirket ve
# IYS kaydi olmadigi icin HICBIR ticari ileti gonderilmez.
# TICARI_ILETI_AKTIF=false
