# Yonetio — URETIM reverse proxy (Caddy v2).
#
# Otomatik Let's Encrypt TLS (HTTP-01; pfSense YALNIZ 80/443 iletir => ACME
# calisir). HTTP->HTTPS yonlendirmesi Caddy'de OTOMATIKTIR. Alt-alanlar
# docker-compose.prod.yml ortam degiskenlerinden gelir ({$VAR}).
#
# Alt-alanlar:
#   kok/www. -> admin-web:3000  (genel portal + /gizlilik, /kosullar)
#   api.     -> api:8000        (FastAPI)
#   panel.   -> admin-web:3000  (Next.js BFF)
#   storage. -> minio:9000      (foto presigned PUT/GET; Host KORUNUR => s3v4 imza gecerli)
#
# IKI ALAN ADI, IKISI DE GECERLI (P120):
#   yönetiyor.com  -> MUSTERIYE DONUK BIRINCIL alan. IDN'dir; Caddy'de
#                     PUNYCODE bicimiyle yazilir (xn--ynetiyor-n4a.com).
#                     Tarayici ve TLS SNI zaten punycode gonderir; unicode
#                     yazmak eslesmeyen bir site blogu birakirdi.
#   yonetio.site   -> ESKI alan, CALISMAYA DEVAM EDER. Yonlendirme YOK:
#                     App Store'a gonderilen yapim `api.yonetio.site`e
#                     bakiyor ve hukuki belge adresleri `yonetio.site`
#                     kokune bakiyor; bunlari kirmak, incelemedeki
#                     uygulamayi kirmak olurdu.
#
# PUNYCODE'U KENDINIZ VARSAYMAYIN. Bu tura `xn--ynetiyor-vpb` etiketiyle
# baslandi; oyle bir alan adi KAYITLI BILE DEGIL (SOA donmuyor). Dogru
# etiket `xn--ynetiyor-n4a`. Goz karariyla ayirt EDILEMEZ; uretin:
#   python3 -c "print('yönetiyor.com'.encode('idna').decode())"
# `infra/alan-adi-denetimi.py` bunu her kosumda yeniden dogrular.
{
	# ACME kayit e-postasi (sertifika sona-erme uyarilari buraya gider).
	email {$ACME_EMAIL}
	# Otomatik HTTPS acik (varsayilan). Yerel/staging test icin asagiyi acabilirsiniz:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# --- ortak guvenlik basliklari (snippet) ---------------------------------- #
(security_headers) {
	header {
		# HSTS — 1 yil, alt-alanlar dahil.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Sunucu parmak izini gizle.
		-Server
	}
}

# --- Genel portal: kok + www (HER IKI ALAN) ------------------------------- #
# NEDEN VAR (P120): kok alan adi bugune kadar HIC sunulmuyordu — Caddy'de
# yalniz api./panel./storage. bloklari vardi. Oysa mobil uygulamada
# `AppConfig.webBaseUrl` = `https://yonetio.site` ve gizlilik/kosullar
# baglantilari oraya gidiyor. OLCULDU: `https://yonetio.site/gizlilik`
# 200 donuyordu ama icerik Hostinger'in "Parked Domain" sayfasiydi (her
# yol 200 donuyor). Yani App Store'a verilen GIZLILIK POLITIKASI ADRESI
# park sayfasi gosteriyordu — 5.1.1 icin tek basina ret sebebi.
#
# Kok, panelin KENDISINI sunar (ayri bir tanitim uygulamasi yok):
# `/gizlilik` ve `/kosullar` zaten admin-web'in PUBLIC rotalaridir.
#
# `app.` DE BURADA (yeni alanda): DNS'te A kaydi ACILMIS ama hicbir site
# blogu yoktu -> TLS el sikismasi "internal error" ile duser, istemci
# HTTP'ye hic gelemez (Kerem'in gordugu `000` budur). Bir konagi DNS'te
# acip Caddy'de tanimlamamak, "site yok" degil "BAGLANTI KOPTU" uretir;
# ikisi cok farkli seylerdir ve ikincisi teshisi zorlastirir.
{$PORTAL_DOMAIN}, www.{$PORTAL_DOMAIN}, {$PORTAL_DOMAIN_ESKI}, www.{$PORTAL_DOMAIN_ESKI} {
	import security_headers
	header X-Frame-Options "DENY"
	encode gzip zstd

	# HUKUKI SAYFALAR GERCEK UYGULAMADAN gelir — TEK KAYNAK.
	# Metinler 7 dilde `admin-web/lib/hukuki/` altindadir ve buraya
	# KOPYALANMAZ: kopyalanan bir gizlilik politikasi bir gun otekiyle
	# celisir ve hangisinin baglayici oldugu belirsizlesir.
	# `/_next/*` DE PROXY'LENIR: sayfalar sunucuda cizilir ama bicimlendirme
	# oradan gelir; unutulursa sayfa BICIMSIZ ama 200 doner — yani sessizce
	# bozulur.
	@uygulama path /gizlilik /gizlilik/* /kosullar /kosullar/* /_next/* /favicon.ico
	handle @uygulama {
		reverse_proxy admin-web:3000
	}

	# GERI KALAN HER SEY: gecici tanitim sayfasi.
	#
	# NEDEN PANELIN KENDISI DEGIL: admin-web'in `/` rotasi `/dashboard`a,
	# oradan da `/login`e gider. Kok, panele baglansaydi markanin ana
	# adresi bir YONETICI GIRIS EKRANI olurdu — ziyaretcinin ilk gordugu
	# sey kendisine ait olmayan bir giris formu olmamali.
	#
	# `file_server` BILINCLI: bilinmeyen yol icin 404 doner. `try_files`
	# ile her yolu index'e dusurmek, her adrese 200 donen bir catch-all
	# uretirdi — tam da Hostinger'in park sayfasinda elestirdigimiz sey.
	handle {
		root * /srv/portal/kok
		file_server
	}
}

# --- app. — GECICI yer tutucu (P40-P42'ye kadar) -------------------------- #
# DNS'te A kaydi vardi, site blogu YOKTU: SNI eslesmeyince TLS el sikismasi
# duser ve ziyaretci ERR_SSL_PROTOCOL_ERROR gorur. Bir adres yayinlandiysa,
# "henuz hazir degil" demek bile baglantinin KOPMUS gorunmesinden iyidir.
app.{$PORTAL_DOMAIN} {
	import security_headers
	header X-Frame-Options "DENY"
	encode gzip zstd
	root * /srv/portal/app
	file_server
}

# --- API ------------------------------------------------------------------ #
# YENI ALANDA API ALT-ALANI ACILMADI (api.yönetiyor.com YOK): mobil yapimin
# icine gomulu adres `api.yonetio.site` ve bu tur o adres DEGISMIYOR. Iki
# API adresi acmak, hangisinin kanonik oldugunu belirsizlestirir ve CORS/
# cerez yuzeyini bedelsiz buyuturdu.
{$API_DOMAIN} {
	import security_headers
	encode gzip zstd
	reverse_proxy api:8000
}

# --- Yonetim paneli (admin-web) ------------------------------------------- #
# IKI ADRES DE AYNI PANELI verir; eskisi AYNEN calismaya devam eder
# (kayitli kullanicinin yer imi ve tarayici parola kasasi ona bagli).
{$PANEL_DOMAIN}, {$PANEL_DOMAIN_YENI} {
	import security_headers
	# Panel clickjacking'e karsi cerceveye alinamaz.
	header X-Frame-Options "DENY"
	encode gzip zstd
	reverse_proxy admin-web:3000
}

# --- Foto deposu (MinIO, presigned URL host'u) ---------------------------- #
# ONEMLI: Caddy v2 reverse_proxy GELEN Host basligini KORUR (nginx'in aksine
# upstream'e gore YENIDEN YAZMAZ). Presigned URL storage. host'u ile imzalandigi
# icin MinIO ayni Host'u gorur => s3v4 imza dogrulanir. Yol da AYNEN korunur
# (path-style: /{bucket}/{key}); prefix soyulmaz. CORS (tarayici PUT preflight)
# MinIO tarafindan yonetilir (varsayilan tum origin'lere izinli).
{$STORAGE_DOMAIN} {
	import security_headers
	reverse_proxy minio:9000 {
		# Buyuk foto yuklemelerinde erken zaman asimini onle.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
