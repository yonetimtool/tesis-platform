# Python
__pycache__/
*.pyc
.pytest_cache/

# Env / secrets
.env
*.env
!*.env.example
# Uretim env (gercek sirlar) — YALNIZ .env.prod.example commit'lenir.
.env.prod
.env.prod.*
!.env.prod.example

# Docker/terminal cop dosyalari (kazara olusan)
infra/=
infra/CACHED
infra/[*
infra/exporting
infra/naming
infra/reading
infra/resolve
infra/transferring
infra/unpacking

# IDE
.idea/
*.iml

# --------------------------------------------------------------------------- #
# FLUTTER — PLATFORM AGACLARI ARTIK BLOKE EDILMEZ
#
# BURADA BIR KEZ `mobile/android/` ve `mobile/ios/` satirlari vardi ve iki
# kez KAYBA yol acti:
#   1. `android/app/src/main/res/xml/network_security_config.xml` —
#      AndroidManifest'in `android:networkSecurityConfig` ile REFERANS
#      VERDIGI dosya hic commit'lenmedi; taze klonda Android yapisi
#      "resource not found" ile duserdi.
#   2. `ios/Runner/PrivacyInfo.xcprivacy`, `Runner.entitlements`,
#      `en/tr.lproj/InfoPlist.strings` ve alti simge (P114) — Kerem'in
#      taze klonunda YOKTU. `project.pbxproj` IZLENDIGI icin guncellendi
#      ve dosyalara referans verdi; yani depo "tutarli gorunup" eksikti.
#
# HATA SINIFI: kaynak/yapilandirma ile derleme ARTIGINI ayni kural
# altinda toplamak. Bir dizini toptan yok saymak, o dizine SONRADAN
# eklenen her kaynagi da sessizce yutar — ve `git status` temiz oldugu
# icin fark edilmez.
#
# DOGRUSU: platform artiklari, Flutter'in KENDI sablon `.gitignore`
# dosyalarinda zaten tanimli ve dogru kapsamda:
#   * `mobile/ios/.gitignore`     -> Flutter/ephemeral, Generated.xcconfig,
#                                    GeneratedPluginRegistrant.*, Pods/,
#                                    .symlinks/, DerivedData/, xcuserdata
#   * `mobile/android/.gitignore` -> .gradle, local.properties, .cxx,
#                                    GeneratedPluginRegistrant.java,
#                                    keystore/key.properties
# Kok dosyada onlari TEKRARLAMAK ya da genisletmek gereksiz; tehlikeli
# olan da tam olarak bu genisletmeydi.
# --------------------------------------------------------------------------- #

# Flutter (mobile kendi .gitignore'una sahip)
mobile/.flutter-plugins-dependencies
mobile/.idea/
mobile/mobile.iml

# Flutter derleme artiklari (KAYNAK DEGIL — platform agaclari haric)
mobile/.dart_tool/
mobile/build/

# Firebase kimlikleri (ASLA commit'lenmez)
infra/secrets/
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# Kapı koşum günlükleri (infra/kapilar.sh) — yerel, sürüm kontrolüne girmez.
.kapilar/
